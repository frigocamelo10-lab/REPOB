local selected

local function apply(data)
	selected = data[1]

	Lighting.FogStart = 99999
	Lighting.FogEnd = 999999

	local v = data[2] / 255
	Lighting.FogColor = Color3.new(v,v,v)

	for _,b in ipairs(list:GetChildren()) do
		if b:IsA("TextButton") then
			local c = b:GetAttribute("bits") == selected and Color3.fromRGB(55,55,65) or Color3.fromRGB(27,27,32)
			TweenService:Create(b,TweenInfo.new(.15),{BackgroundColor3=c}):Play()
		end
	end
end


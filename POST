local showing = false
local busy = false

local function show()
	if busy then return end
	busy = true
	showing = true

	frame.Visible = true
	shadow.Visible = true
	frame.Size = UDim2.fromScale(.38,.48)
	frame.BackgroundTransparency = 1
	shadow.Size = UDim2.fromScale(.38,.48)
	shadow.BackgroundTransparency = 1

	local a = TweenService:Create(frame,TweenInfo.new(.28,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
		Size=UDim2.fromScale(.47,.6),
		BackgroundTransparency=0
	})

	local b = TweenService:Create(shadow,TweenInfo.new(.22),{
		Size=UDim2.fromScale(.49,.62),
		BackgroundTransparency=.55
	})

	a:Play()
	b:Play()
	a.Completed:Wait()
	busy = false
end

local function hide()
	if busy then return end
	busy = true
	showing = false

	local a = TweenService:Create(frame,TweenInfo.new(.2,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
		Size=UDim2.fromScale(.38,.48),
		BackgroundTransparency=1
	})

	local b = TweenService:Create(shadow,TweenInfo.new(.18),{
		Size=UDim2.fromScale(.38,.48),
		BackgroundTransparency=1
	})

	a:Play()
	b:Play()
	a.Completed:Wait()

	frame.Visible = false
	shadow.Visible = false
	busy = false
end

open.MouseButton1Click:Connect(function()
	if showing then
		hide()
	else
		show()
	end
end)

close.MouseButton1Click:Connect(hide)

